<Window x:Class="UsbWriteBlocker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="USB Write Blocker — Adli Bilişim"
        Height="720" Width="620"
        MinHeight="640" MinWidth="560"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6">
    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.88"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Başlık -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="USB Write Blocker" FontSize="24" FontWeight="Bold" Foreground="#111827"/>
            <TextBlock Text="Adli Bilişim İnceleme Aracı — Delil Bütünlüğü Koruması" FontSize="13" Foreground="#6B7280" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Durum Kartı -->
        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="20" Margin="0,0,0,16"
                BorderBrush="#E5E7EB" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="StatusDot" Width="22" Height="22" Fill="#22C55E" VerticalAlignment="Center"/>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusTitle" Text="KORUMASIZ" FontSize="18" FontWeight="Bold" Foreground="#111827"/>
                    <TextBlock x:Name="StatusSubtitle" Text="USB depolama aygıtlarına yazma işlemi engellenmiyor." FontSize="12" Foreground="#6B7280" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Butonlar -->
        <Grid Grid.Row="2" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="EnableButton" Grid.Column="0" Style="{StaticResource ActionButton}"
                    Background="#DC2626" Content="Yazma Korumasını Etkinleştir" Click="EnableButton_Click"/>
            <Button x:Name="DisableButton" Grid.Column="2" Style="{StaticResource ActionButton}"
                    Background="#4B5563" Content="Yazma Korumasını Devre Dışı Bırak" Click="DisableButton_Click"/>
        </Grid>

        <!-- Kritik Uyarı -->
        <Border Grid.Row="3" Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="ÖNEMLİ — İnceleme Öncesi Sıra" FontWeight="Bold" Foreground="#92400E" FontSize="13"/>
                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#78350F" FontSize="12" LineHeight="18">
                    İncelenecek USB aygıtı bilgisayara takılmadan ÖNCE bu programı "Write Blocker AKTİF" durumuna getirin.
                    Aygıt zaten takılıysa, önce etkinleştirin, sonra aygıtı çıkarıp yeniden takın; aksi halde daha önce
                    bağlanmış (mount edilmiş) sürücü salt-okunur duruma geçmeyebilir.
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Kullanım Talimatları -->
        <Border Grid.Row="4" Background="White" CornerRadius="10" Padding="18" BorderBrush="#E5E7EB" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Kullanım Talimatları" FontSize="15" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,10"/>

                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#374151" Margin="0,0,0,10" LineHeight="18">
                        Bu yazılım, Windows işletim sisteminin depolama aygıtı politikalarını kullanarak
                        (StorageDevicePolicies / WriteProtect) sisteme bağlı TÜM USB kitle depolama aygıtlarını
                        yazılımsal olarak salt-okunur hale getirir. Etkinleştirildiğinde hem takılı hem de yeni
                        takılacak USB sürücülere yazma, silme, yeniden adlandırma ve zaman damgası değiştirme
                        işlemleri işletim sistemi tarafından engellenir.
                    </TextBlock>

                    <TextBlock Text="1) İnceleme Öncesi" FontWeight="SemiBold" FontSize="12.5" Foreground="#111827" Margin="0,6,0,2"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#374151" LineHeight="18">
                        "Yazma Korumasını Etkinleştir" butonuna basın. Durum göstergesi kırmızıya dönecek ve
                        sistem tepsisindeki (saat yanı) ikon kırmızı olacaktır. Bu, sistemin artık "Write Blocker"
                        modunda olduğu anlamına gelir.
                    </TextBlock>

                    <TextBlock Text="2) USB Aygıtın Takılması" FontWeight="SemiBold" FontSize="12.5" Foreground="#111827" Margin="0,10,0,2"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#374151" LineHeight="18">
                        Write Blocker etkinken incelenecek USB aygıtı takın. Aygıt zaten bilgisayara takılıymış ise,
                        etkinleştirdikten sonra aygıtı çıkarıp tekrar takmanız gerekir; aksi halde önceden bağlanmış
                        sürücü salt-okunur duruma geçmemiş olabilir. Kural: "Önce koru, sonra tak."
                    </TextBlock>

                    <TextBlock Text="3) İnceleme Sırasında" FontWeight="SemiBold" FontSize="12.5" Foreground="#111827" Margin="0,10,0,2"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#374151" LineHeight="18">
                        Write Blocker aktifken USB aygıttan dosya kopyalayabilir, görüntüleyebilir ve inceleme
                        yazılımlarınızla (imaj alma, hash hesaplama vb.) okuma işlemleri yapabilirsiniz. Aygıta
                        yazma girişimleri Windows tarafından "Erişim engellendi" / salt okunur hatası ile reddedilir.
                    </TextBlock>

                    <TextBlock Text="4) İnceleme Sonrası" FontWeight="SemiBold" FontSize="12.5" Foreground="#111827" Margin="0,10,0,2"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#374151" LineHeight="18">
                        İnceleme bittiğinde normal USB kullanımına dönmek için "Yazma Korumasını Devre Dışı Bırak"
                        butonuna basın. Durum göstergesi ve tepsi ikonu yeşile döner.
                    </TextBlock>

                    <TextBlock Text="5) Kalıcılık Notu" FontWeight="SemiBold" FontSize="12.5" Foreground="#111827" Margin="0,10,0,2"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#374151" LineHeight="18">
                        Write Blocker durumu Windows kayıt defterinde (registry) saklanır. Programı kapatsanız veya
                        bilgisayarı yeniden başlatsanız bile ayar kalıcıdır — koruma açık bırakıldıysa açık kalır.
                        Korumayı kapatmak için programı tekrar açıp "Devre Dışı Bırak" seçmeniz gerekir.
                    </TextBlock>

                    <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,14,0,0">
                        <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="#1E3A8A" LineHeight="17">
                            Not: Bu bir yazılımsal write blocker'dır (işletim sistemi seviyesinde koruma).
                            Adli kabul edilebilirlik gerektiren resmi delil işlemlerinde, mümkünse sertifikalı bir
                            donanım write blocker ile birlikte veya onun yerine kullanılması değerlendirilmelidir.
                        </TextBlock>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <TextBlock Grid.Row="5" Text="Sistem tepsisindeki ikon programın anlık durumunu gösterir: Yeşil = korumasız, Kırmızı = Write Blocker aktif."
                   FontSize="11" Foreground="#9CA3AF" Margin="0,14,0,0" TextWrapping="Wrap"/>
    </Grid>
</Window>
